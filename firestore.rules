rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios_admin/$(request.auth.uid));
    }

    match /registros/{docId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();  // TEMPORAL: botón de eliminar en dashboard
      allow create, update: if false;
    }

    match /usuarios_admin/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /sucursales_participantes/{numero} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /configuracion/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
